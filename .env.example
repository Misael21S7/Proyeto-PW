# Copia este archivo como .env y completa los valores.

# Clave de la API de Gemini (obtenla en https://aistudio.google.com/apikey).
# Solo se usa en el servidor local para la transcripción OCR de imágenes.
GEMINI_API_KEY=""

# Opcional: puerto del servidor local (por defecto 3000).
PORT=3000

# Opcional: modelos a usar, separados por coma (el primero es el principal
# y los siguientes son respaldo).
# GEMINI_MODELS="gemini-2.5-flash,gemini-2.0-flash"
